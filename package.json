{
  "name": "xmail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, self-hosted NetEase and QQ inbox powered by Vue 3, Vite, Node.js and IMAP.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@vueuse/core": "^14.0.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.2.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "imapflow": "^1.0.195",
    "lenis": "^1.3.26",
    "lucide-vue-next": "^0.545.0",
    "mailparser": "^3.7.4",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "postcss-pxtorem": "^6.1.0",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=20.19"
  }
}

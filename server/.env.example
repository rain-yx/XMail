# Node API port
PORT=3000

# Optional: fixed key material for encrypted persistent login sessions.
# Keep this value stable between deployments. When omitted, XMail creates a local key file.
# SESSION_SECRET=replace-with-a-long-random-secret

# Optional directory for encrypted session data (defaults to server/data)
# XMAIL_DATA_DIR=./data

# Production enables Secure cookies. The public site must use HTTPS.
NODE_ENV=development

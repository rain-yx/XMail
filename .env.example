# Node API and production web server port
PORT=3000

# Optional: fixed key material for encrypted persistent login sessions.
# Keep this value stable between deployments. When omitted, XMail creates a local key file.
# SESSION_SECRET=replace-with-a-long-random-secret

# Optional directory for encrypted session data (defaults to .xmail-data)
# XMAIL_DATA_DIR=./.xmail-data

# Set to production when the app is served behind HTTPS
NODE_ENV=development
